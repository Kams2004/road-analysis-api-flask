# VIASafe — SFTP video sources: passwords (copy to sftp.env, chmod 600).
#
#   cp sftp.env.example sftp.env && chmod 600 sftp.env && nano sftp.env
#
# One line per server, named after the "password key" of the server in the
# web console (Cloud sources → Add a source → SFTP server). The value is read
# at each connection; it is never stored in the database, shown in the UI,
# returned by the API or written to any log. Never commit sftp.env.
#
# SFTP_PASSWORD_<KEY>=<password>        (no quotes needed; quotes are stripped)
SFTP_PASSWORD_CAMTRACK=change-me

# Optional key-based authentication instead of a password: a private key file
# placed in this same directory (plain file name, no path) + its passphrase.
# SFTP_KEYFILE_CAMTRACK=camtrack_ed25519
# SFTP_KEY_PASSPHRASE_CAMTRACK=
